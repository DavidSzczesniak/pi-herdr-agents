{
  "name": "pi-herdr-agents",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "check": "tsc -p .",
    "transport-check": "vitest run transport.test.ts",
    "adapter-check": "vitest run adapter.test.ts",
    "launch-race-check": "vitest run launch-race.test.ts",
    "fixture-isolation-check": "vitest run fixture-isolation.test.ts",
    "startup-check": "vitest run startup.test.ts",
    "selection-check": "vitest run selection.test.ts",
    "retirement-check": "node retirement-check.ts",
    "test": "npm run check && vitest run && npm run claude-check",
    "claude-check": "node claude-check.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@types/node": "24.13.3",
    "typebox": "1.1.38",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
